@import "../../styles/colors.pcss";
@import "../../styles/layout.pcss";
@import "../../styles/variables.pcss";
@import "../../styles/fonts.pcss";

:global(html) {
  box-sizing: border-box;
}
:global(*), :global(*):before, :global(*):after {
  box-sizing: inherit;
}

:global(html), :global(body), :global(main), :global(#app) {
  width: 100%;
  height: 100%;
  overflow: auto;
}

:global(.rdg-editor-container) {
  /* React Data Grid has an inline style on the div that wraps the editor
   that sets z-index to 2. This makes it get hidden when using the mass editor,
   which also needs to set z-index.*/
  z-index: 150 !important;
}

.container {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  font-size: 14px;
  font-family: 'Nunito', sans-serif;
  overflow: auto;
}

.main-content {
  flex: 1;
  display: flex;
}

.status-bar {
  flex: 0 0 1rem;
  width: 100%;
  border-top: 1px solid var(--border-color);
}

.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;
  z-index: 500;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.7);
}

.loading-message {
  margin-top: 1em;
  font-size: 1.1em;
}

:global(.ant-message-custom-content) {
  line-height: 24px;
  max-height: calc(24px * 5);
  overflow: auto;
}

